config_version: 2
interval: {{interval}}
request.method: GET
request.url: {{base_url}}/external/logs
request.timeout: 120s
{{#if verify}}
request.ssl.verification_mode: full
{{else}}
request.ssl.verification_mode: none
{{/if}}
request.headers:
  Authorization: "Bearer {{bearer_token}}"
request.transforms:
  - set:
      target: url.params.page
      value: '1'
  - set:
      target: url.params.limit
      value: '500'
response.split:
  target: body.items
  ignore_empty_value: true
response.pagination:
  - set:
      target: url.params.page
      value: '[[if (eq (len .last_response.body.items) 500)]][[add (toInt .last_response.url.params.Get "page") 1]][[end]]'
      fail_on_template_error: true
      do_not_log_failure: true