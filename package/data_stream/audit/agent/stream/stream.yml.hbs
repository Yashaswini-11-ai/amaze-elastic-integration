config_version: 2
interval: {{interval}}
request.method: GET
request.url: {{base_url}}/audit-log
request.timeout: 120s
{{#if verify}}
request.ssl.verification_mode: full
{{else}}
request.ssl.verification_mode: none
{{/if}}
request.headers:
  Authorization: "Bearer {{bearer_token}}"
request.transforms:
  - set:
      target: url.params.from
      value: '[[.cursor.last_timestamp]]'
      default: '[[formatDate (now (parseDuration "-{{initial_interval}}")) "2006-01-02T15:04:05Z"]]'
  - set:
      target: url.params.limit
      value: '500'
response.split:
  target: body.items
  ignore_empty_value: true
cursor:
  last_timestamp:
    value: '[[.last_event.timestamp]]'